{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siphon",
  "version": "0.22.0",
  "identifier": "app.siphon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Siphon",
        "width": 940,
        "height": 740,
        "minWidth": 680,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com; img-src 'self' https: http: data: blob:; media-src 'self' https: http: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/preview/**",
          "$APPCACHE/frames/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRURGOEIwNTlCNEIxODAKUldTQXNiUlpzUGp0YzNJNWhwVHFSQmsxYTJTRXRRWXdoUUlXVkxkVS9DUGs2Z1B4QmlHQ3ZIbFUK",
      "endpoints": [
        "https://github.com/Iosif-Christogeorgos/siphon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
